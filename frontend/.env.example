# false = backend dla jednej działki ewidencyjnej, dane demonstracyjne dla grup i własnych obszarów
# true = dane demonstracyjne dla wszystkich wyborów
VITE_USE_MOCK=false

# Adres API. Lokalnie Vite przekazuje /api na http://127.0.0.1:8000.
VITE_API_URL=/api

# Usługa wyszukiwania działek (GUGiK ULDK)
VITE_ULDK_URL=https://uldk.gugik.gov.pl/
