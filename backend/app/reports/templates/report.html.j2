<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <title>Vedra | Raport gospodarowania wodą</title>
</head>
<body>
{% import "_parts.html.j2" as parts with context %}
{# One section per report. Reports of different parcels or dates in one PDF each start on a new page. #}
{% for entry in entries %}
{% set report = entry.report %}
<article class="report{% if not loop.first %} next-report{% endif %}">
<header>
  <p class="wordmark">VEDRA</p>
  <h1>Raport gospodarowania wodą</h1>
  {{ parts.identity([
    ("Działka ewidencyjna", report.parcel.parcel_id),
    ("Obręb", report.parcel.region),
    ("Uprawa", report.crop_name_pl),
    ("Data analizy", report.analysis_date),
  ]) }}
</header>
<main>
  {{ parts.assessment(report, "Sytuacja wodna działki") }}
  {{ parts.map_section(entry.map_url) }}
  {{ parts.signals(report.assessment.signals) }}
  {{ parts.vulnerability(report, entry.chart_url) }}
  {{ parts.causes(report.causes) }}
  {{ parts.recommendations(report.recommendations, report.references, "Zalecane działania",
                           "Dostępne dane nie pozwalają wskazać działań dla działki.") }}
  {{ parts.irrigation(report.irrigation) }}
  {{ parts.appendix(report.limitations_pl, report.data_sources, report.references) }}
</main>
</article>
{% endfor %}
</body>
</html>
