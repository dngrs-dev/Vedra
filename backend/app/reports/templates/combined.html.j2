<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <title>Vedra | Raport gospodarowania wodą</title>
</head>
<body>
{% import "_parts.html.j2" as parts with context %}
{# Several crops of one parcel: a general part, one part per crop from a new page and a shared appendix. #}
{% set varies = document.has_crop_values %}
<article class="report">
<header>
  <p class="wordmark">VEDRA · {{ part_general | upper }}</p>
  <h1>Raport gospodarowania wodą</h1>
  {{ parts.identity([
    ("Działka ewidencyjna", document.parcel.parcel_id),
    ("Obręb", document.parcel.region),
    ("Uprawy", document.crop_names | join(", ")),
    ("Data analizy", document.analysis_date),
  ]) }}
</header>
<main>
  <section>
    <h2>Podsumowanie dla upraw</h2>
    <p>{{ overview_text }}</p>
    <table class="overview">
      <thead><tr><th>Uprawa</th><th>Ocena</th><th class="number">KBW</th><th class="number">Próg uprawy</th></tr></thead>
      <tbody>
      {% for crop in crops %}
        {% set kbw = crop.part.report.assessment.kbw %}
        <tr>
          <td>{{ crop.part.report.crop_name_pl }}</td>
          <td>{{ verdict_labels[kbw.verdict] }}</td>
          <td class="number">{% if kbw.kbw_mm is not none %}{{ kbw.kbw_mm | display_value }} mm{% else %}{{ missing }}{% endif %}</td>
          <td class="number">{% if kbw.threshold_mm is number %}{{ kbw.threshold_mm | display_value }} mm{% else %}—{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  {{ parts.map_section(map_url) }}
  {{ parts.signals(document.signals, "Wskaźniki dla działki", varies) }}
  {{ parts.causes(document.causes, "Przyczyny niedoboru wody wspólne dla upraw", varies) }}
  {{ parts.recommendations(document.recommendations, document.references, "Działania zalecane dla wszystkich upraw",
                           none, varies) }}
  {{ parts.irrigation(document.irrigation) }}
</main>
</article>

{% for crop in crops %}
{% set part = crop.part %}
<article class="report next-report crop-part">
<header>
  <p class="wordmark">VEDRA · UPRAWA {{ loop.index }} Z {{ loop.length }}</p>
  <h1>{{ part.report.crop_name_pl }}</h1>
</header>
<main>
  {{ parts.assessment(part.report, "Ocena dla uprawy") }}
  {{ parts.vulnerability(part.report, crop.chart_url) }}
  {% if part.details %}
  <section>
    <h2>{{ crop_values_heading }}</h2>
    <p>{{ crop_values_intro }}</p>
    {% for detail in part.details %}
      <div class="item"><h3>{{ detail.title }}</h3>{{ parts.metrics(detail.metrics) }}</div>
    {% endfor %}
  </section>
  {% endif %}
  {{ parts.signals(part.signals, "Wskaźniki dla uprawy") }}
  {{ parts.causes(part.causes, "Przyczyny dotyczące uprawy") }}
  {{ parts.recommendations(part.recommendations, document.references, "Działania dla uprawy", no_extra_actions) }}
  {{ parts.irrigation(part.irrigation) }}
</main>
</article>
{% endfor %}

<article class="report next-report">
<header>
  <p class="wordmark">VEDRA · {{ part_appendix | upper }}</p>
  <h1>{{ part_appendix }}</h1>
</header>
<main>
  {{ parts.appendix(document.limitations, document.data_sources, document.references) }}
</main>
</article>
</body>
</html>
